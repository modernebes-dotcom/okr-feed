#!/bin/sh
set -eu
root="$(git rev-parse --show-toplevel)"
python_bin="$(git config --get codex.python || printf python)"
"$python_bin" "$root/.repo-security/check_secrets.py" --pre-push
previous="$(git config --get codex.previousHooksPath || true)"
if [ -n "$previous" ] && [ -x "$previous/pre-push" ]; then "$previous/pre-push" "$@"; fi
